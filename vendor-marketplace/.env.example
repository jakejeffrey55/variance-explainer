# ---- Core ----
DATABASE_URL="postgresql://user:password@localhost:5432/vendor_marketplace?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# ---- Integration adapters ----
# Property sync: csv (active) | powerbi (stub) | onesite (stub)
PROPERTY_SYNC_PROVIDER="csv"
# Requisition (Coupa): mock (no API access yet)
REQUISITION_PROVIDER="mock"
# Contract system: mock
CONTRACT_PROVIDER="mock"
# Vendor credentialing (Vendorply): csv
VENDOR_SYNC_PROVIDER="csv"

# Reserved for when API access lands — providers stay stubbed until set.
POWERBI_CLIENT_ID=""
POWERBI_CLIENT_SECRET=""
POWERBI_TENANT_ID=""
POWERBI_DATASET_ID=""
ONESITE_BASE_URL=""
ONESITE_API_KEY=""
COUPA_BASE_URL=""
COUPA_API_KEY=""

# ---- Real integrations ----
GOOGLE_PLACES_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
